SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_browser_safe_key

# Optional: comma-separated company domains. Leave unset while testing if
# more than one Google Workspace domain may be used.
# GOOGLE_ALLOWED_DOMAINS=playbook.example,oh.example

# Required to enable Google Calendar sync. Use the same Google OAuth Web client
# configured in Supabase. Keep the client secret and encryption key server-only.
# GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-random-key

# Generate a unique encryption key locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never change this key after people connect Calendar, or their stored refresh
# tokens can no longer be decrypted.

# Legacy Supabase projects may use this instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
